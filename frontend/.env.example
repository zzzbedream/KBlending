# Copy to .env.local and fill in after deploying the contracts to KUB testnet.
# Only NEXT_PUBLIC_* vars are exposed to the browser — never put secrets here.

# Chain
NEXT_PUBLIC_CHAIN_ID=25925
NEXT_PUBLIC_RPC_URL=https://rpc-testnet.bitkubchain.io
NEXT_PUBLIC_EXPLORER=https://testnet.bkcscan.com

# Deployed contract addresses (from the Deploy script logs)
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_REALX_ADDRESS=
NEXT_PUBLIC_KUSDT_ADDRESS=
NEXT_PUBLIC_ORACLE_ADDRESS=

# Optional: Bitkub NEXT custodial wallet (leave empty to use injected EVM wallets only).
# Requires a registered Bitkub NEXT dApp (clientID / sdkID).
NEXT_PUBLIC_BITKUB_CLIENT_ID=
NEXT_PUBLIC_BITKUB_SDK_ID=
