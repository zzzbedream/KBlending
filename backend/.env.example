# Copy to .env and fill in. Never commit the real .env.

PORT=4000
# Comma-separated allowed origins for CORS (the dashboard URL). Use * for local dev.
CORS_ORIGIN=*

# KUB Chain RPC (testnet chainId 25925)
RPC_URL=https://rpc-testnet.bitkubchain.io
CHAIN_ID=25925

# Deployed contract addresses (from the Foundry deploy logs)
VAULT_ADDRESS=
COLLATERAL_ADDRESS=
BORROW_ADDRESS=

# Indexer: block to start indexing from (the vault deployment block) and poll cadence.
START_BLOCK=0
POLL_INTERVAL_MS=15000
# Max block span per getLogs request (tune to your RPC's limits).
LOG_CHUNK_SIZE=5000
