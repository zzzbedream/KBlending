# Copy to .env and fill in. NEVER commit the real .env (it is git-ignored).

# Deployer key for `forge script`. Use a dedicated testnet key with only test funds.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# KUB Chain (Bitkub Chain) RPC endpoints — confirm against current Bitkub docs.
# Testnet: chainId 25925 | Mainnet: chainId 96
KUB_TESTNET_RPC_URL=https://rpc-testnet.bitkubchain.io
KUB_MAINNET_RPC_URL=https://rpc.bitkubchain.io

# Blockscout API key for contract verification (may be empty for open Blockscout instances).
KUBSCAN_API_KEY=
